{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politicometro.example/schemas/case.schema.json",
  "title": "Politicometro Case",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "why_it_matters",
    "status",
    "evidence_strength",
    "impact",
    "responsibility",
    "sources",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 10 },
    "summary": { "type": "string", "minLength": 30 },
    "why_it_matters": { "type": "string", "minLength": 20 },
    "status": {
      "type": "string",
      "enum": [
        "unverified_signal",
        "initial_corroboration",
        "partially_documented",
        "documented",
        "contested",
        "proceeding_ongoing",
        "established",
        "refuted",
        "dismissed",
        "acquitted",
        "unresolved",
        "closed",
        "needs_update"
      ]
    },
    "evidence_strength": { "type": "integer", "minimum": 0, "maximum": 5 },
    "impact": { "type": "integer", "minimum": 0, "maximum": 5 },
    "responsibility": { "type": "integer", "minimum": 0, "maximum": 5 },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role_in_case"],
        "properties": {
          "name": { "type": "string" },
          "role_in_case": { "type": "string" },
          "entity_type": {
            "type": "string",
            "enum": ["person", "party", "public_body", "company", "foundation", "association", "other"]
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "claim_type", "verification_status"],
        "properties": {
          "text": { "type": "string" },
          "claim_type": {
            "type": "string",
            "enum": ["fact", "promise", "prediction", "opinion", "accusation"]
          },
          "verification_status": {
            "type": "string",
            "enum": ["true", "mostly_true", "incomplete", "missing_context", "misleading", "false", "unverifiable", "pending"]
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "source_type", "published_at"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "source_type": {
            "type": "string",
            "enum": ["official", "investigative", "local", "expert", "social", "dataset", "court", "reply", "other"]
          },
          "published_at": { "type": "string", "format": "date-time" },
          "is_original_reporting": { "type": "boolean" },
          "supports": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reply": {
      "type": ["object", "null"],
      "properties": {
        "requested_at": { "type": "string", "format": "date-time" },
        "received_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "human_review": {
      "type": "object",
      "required": ["required", "completed"],
      "properties": {
        "required": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "reviewer": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
